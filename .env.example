# Diese Datei kopieren nach ".env.local" und die Werte aus Supabase eintragen
# (Supabase Dashboard -> Project Settings -> API)

# Adresse deines Supabase-Projekts, z. B. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" / "publishable" Schlüssel (darf öffentlich sein)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / "secret" Schlüssel. GEHEIM! Niemals weitergeben oder ins GitHub-Repo laden.
SUPABASE_SERVICE_ROLE_KEY=

# Die Adresse, unter der die App später erreichbar ist (für die WhatsApp-Links)
# lokal: http://localhost:3000   später z. B.: https://pferde.deinedomain.de
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Design der App: stall (klassisch grün/beige), sport (modern hell) oder premium (dunkel/gold)
NEXT_PUBLIC_DESIGN=stall
